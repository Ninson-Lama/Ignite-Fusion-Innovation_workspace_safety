# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files (the non-secret template remains tracked)
.env
.env.local
.env.*.local
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/supabase/.temp/
