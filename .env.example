# IFI Safety360 browser-safe Supabase configuration.
# Copy this file to .env.local and replace placeholders. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Compatibility fallback for legacy Supabase projects only. Prefer the
# publishable key above and do not set both unless the application owner has
# deliberately verified the precedence.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LEGACY_ANON_KEY

# Never add SUPABASE_SERVICE_ROLE_KEY or a database password to this frontend
# template. A service-role key bypasses RLS and must not be browser-exposed.
